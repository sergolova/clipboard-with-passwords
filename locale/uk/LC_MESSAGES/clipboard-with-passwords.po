msgstr "файл(и) у"

#: extension.js:401
msgid "(files)"
msgstr "(файли)"

#: extension.js:461
msgid "Type here to search..."
msgstr "Пишіть тут для пошуку..."

#: extension.js:569 prefs.js:736
msgid "Private mode"
msgstr "Приватний режим"

#: extension.js:583 prefs.js:739
msgid "Clear history"
msgstr "Очистити історію"

#: extension.js:608
msgid "Reset Timer"
msgstr "Скинути таймер"

#: extension.js:629
msgid "Settings"
msgstr "Параметри"

#: extension.js:651
msgid "Clipboard is empty"
msgstr "Вміст буфера обміну порожній"

#: extension.js:669
msgid "Copied from vault"
msgstr "Скопійовано зі сховища"

#: extension.js:1121
msgid "lines"
msgstr "рядків"

#: extension.js:1530
msgid "Preview Image"
msgstr "Перегляд зображення"

#: extension.js:1578 passwordVaultDialog.js:377 prefs.js:226
msgid "Edit"
msgstr "Редагувати"

#: extension.js:1624 extension.js:1637
msgid "Remove privacy mask"
msgstr "Зняти маску приватності"

#: extension.js:1624 extension.js:1638
msgid "Apply privacy mask"
msgstr "Застосувати маску приватності"

#: extension.js:1650 passwordVaultDialog.js:39 prefs.js:216
msgid "Paste"
msgstr "Вставити"

#: extension.js:1744
msgid "Delete pinned item?"
msgstr "Видалити пришпилений запис?"

#: extension.js:1745
msgid "Are you sure you want to delete this pinned item?"
msgstr "Справді видалити цей пришпилений запис?"

#: extension.js:1746 extension.js:1757
msgid "This operation cannot be undone."
msgstr "Цю операцію неможливо скасувати."

#: extension.js:1748 passwordVaultDialog.js:632 passwordVaultDialog.js:851
#: prefs.js:206
msgid "Delete"
msgstr "Видалити"

#: extension.js:1748 extension.js:1759 extension.js:2031 extension.js:2067
#: passwordVaultDialog.js:198 passwordVaultDialog.js:624
#: passwordVaultDialog.js:844
msgid "Cancel"
msgstr "Скасувати"

#: extension.js:1755
msgid "Clear all?"
msgstr "Очистити все?"

#: extension.js:1756
msgid "Are you sure you want to delete all clipboard items?"
msgstr "Справді видалити всі записи з буфера обміну?"

#: extension.js:1759
msgid "Clear"
msgstr "Очистити"

#: extension.js:1780
msgid "Clipboard history cleared automatically"
msgstr "Історію буфера обміну очищено автоматично"

#: extension.js:1781
msgid "Clipboard history cleared"
msgstr "Історію буфера обміну очищено"

#: extension.js:2030
msgid "Copied to clipboard"
msgstr "Скопійовано до буфера обміну"

#: extension.js:2062
msgid ""
"This clipboard item is %1$s and was not added: the history would grow to "
"%2$s, over the %3$s limit. Raise «Cache file size» in the settings, or clear "
"the history, to keep copying large items."
msgstr ""
"Цей елемент буфера обміну розміром %1$s не додано: історія виросла б до "
"%2$s, що перевищує межу в %3$s. Збільште «Розмір файлу кэшу» у налаштуваннях "
"або очистіть історію, щоб і далі копіювати великі елементи."

#: extension.js:2592
msgid "Create the master password for the new vault:"
msgstr "Створіть майстер-пароль для нового сховища:"

#: extension.js:2593 passwordVaultDialog.js:92
msgid "Enter the master password to unlock:"
msgstr "Введіть головний пароль для розблокування:"

#: extension.js:2604
msgid "Use a long, unique passphrase — the vault password cannot be recovered."
msgstr "Використовуйте довгу унікальну фразу-пароль — відновити пароль сховища неможливо."

#: extension.js:2607 passwordVaultDialog.js:643
msgid "Create"
msgstr "Створити"

#: extension.js:2608 passwordVaultDialog.js:205
msgid "Unlock"
msgstr "Розблокувати"

#: extension.js:2669 passwordVault.js:740 passwordVault.js:764
#: passwordVault.js:786 passwordVault.js:808 passwordVault.js:811
msgid "Failed to update the password vault archive."
msgstr "Не вдалося оновити архів сховища паролів."

#: extension.js:2691 passwordVault.js:781
msgid ""
"Another file already exists at the target archive path: %1$s. Move or delete "
"it, then try again."
msgstr ""
"За цільовим шляхом архіву вже існує інший файл: %1$s. Перемістіть або "
"видаліть його та спробуйте ще раз."

#: extension.js:2696
msgid "Convert vault format now?"
msgstr "Перетворити формат сховища зараз?"

#: extension.js:2697
msgid ""
"The vault is currently stored as %1$s, but %2$s is selected in Settings."
msgstr ""
"Зараз сховище зберігається як %1$s, але в налаштуваннях вибрано формат %2$s."

#: extension.js:2698
msgid ""
"%1$d records will be migrated into the new archive. The previous file is "
"kept and can be deleted afterwards."
msgstr ""
"%1$d записів буде перенесено в новий архів. Попередній файл збережеться — "
"його можна буде видалити після перетворення."

#: extension.js:2699
msgid "Convert now"
msgstr "Перетворити зараз"

#: extension.js:2700
msgid "Not now"
msgstr "Не зараз"

#: extension.js:2716
msgid "Vault converted"
msgstr "Сховище перетворено"

#: extension.js:2717
msgid "%1$d records were migrated into: %2$s"
msgstr "%1$d записів перенесено до: %2$s"

#: extension.js:2718
msgid ""
"The old archive (%1$s) and its backup (%2$s, if present) are still on disk. "
"Each of them is a full copy of your vault data. Delete both now? The new "
"archive was verified after writing."
msgstr "Старий архів (%1$s) і його резервна копія (%2$s, якщо вона є) досі на диску. Кожен з них — повна копія даних сховища. Видалити обидва зараз? Новий архів було перевірено після запису."

#: extension.js:2721
msgid "Delete archive and backup"
msgstr "Видалити архів і резервну копію"

#: extension.js:2722
msgid "Keep both"
msgstr "Залишити обидва"

#: extension.js:2757
msgid "The password vault has been locked."
msgstr "Сховище паролів було заблоковано."

#: extension.js:3069
msgid "Clipboard cleared"
msgstr "Буфер обміну очищено"

#: passwordVaultDialog.js:98
msgid "Master password"
msgstr "Головний пароль"

#: passwordVaultDialog.js:114
msgid "Repeat the master password"
msgstr "Повторіть головний пароль"

#: passwordVaultDialog.js:267
msgid ""
"A longer passphrase is much harder to guess — the vault password cannot be "
"recovered."
msgstr "Чим довша фраза-пароль, тим важче її підібрати — відновити пароль сховища неможливо."

#: passwordVaultDialog.js:269
msgid ""
"Good length. Keep this passphrase unique — do not reuse another account's "
"password."
msgstr "Хороша довжина. Зробіть фразу унікальною — не використовуйте пароль з іншого облікового запису."

#: passwordVaultDialog.js:290
msgid "Password cannot be empty"
msgstr "Пароль не може бути порожнім"

#: passwordVaultDialog.js:297
msgid "The two passwords do not match."
msgstr "Паролі не збігаються."

#: passwordVaultDialog.js:300
msgid "Unlocking…"
msgstr "Розблокування…"

#: passwordVaultDialog.js:306 passwordVaultDialog.js:311
msgid "Wrong password or archive error"
msgstr "Неправильний пароль або помилка архіву"

#: passwordVaultDialog.js:377
msgid "New service"
msgstr "Новий сервіс"

#: passwordVaultDialog.js:382
msgid "Category:"
msgstr "Категорія:"

#: passwordVaultDialog.js:472
msgid "Category name (e.g. Work)"
msgstr "Назва категорії (напр., Робота)"

#: passwordVaultDialog.js:484
msgid "Service name:"
msgstr "Назва сервісу:"

#: passwordVaultDialog.js:488
msgid "For example: GitHub"
msgstr "Наприклад: GitHub"

#: passwordVaultDialog.js:498
msgid "Description:"
msgstr "Опис:"

#: passwordVaultDialog.js:502
msgid "Description (optional)"
msgstr "Опис (необов’язково)"

#: passwordVaultDialog.js:512
msgid "Login / Email:"
msgstr "Логін / ел. пошта:"

#: passwordVaultDialog.js:526 passwordVaultDialog.js:545
#: passwordVaultDialog.js:546
msgid "Password:"
msgstr "Пароль:"

