msgstr "Додати сервіс"

#: passwordVaultMenu.js:302
msgid "Lock the password vault"
msgstr "Заблокувати сховище паролів"

#: passwordVaultMenu.js:359
msgid "Clear recent service"
msgstr "Очистити нещодавній сервіс"

#: passwordVaultMenu.js:375 passwordVaultMenu.js:736 passwordVaultMenu.js:894
msgid "Login"
msgstr "Логін"

#: passwordVaultMenu.js:383 passwordVaultMenu.js:741
msgid "Extra field"
msgstr "Додаткове поле"

#: passwordVaultMenu.js:563
msgid "Vault is empty. Press + to add a service."
msgstr "Сховище порожнє. Натисніть +, щоб додати сервіс."

#: passwordVaultMenu.js:636
msgid "Type to reveal services…"
msgstr "Введіть текст, щоб показати сервіси…"

#: passwordVaultMenu.js:668
msgid "Nothing found."
msgstr "Нічого не знайдено."

#: passwordVaultMenu.js:669
#, python-format
msgid "Nothing found in «%s»."
msgstr "У категорії «%s» нічого не знайдено."

#: passwordVaultMenu.js:723
msgid "Copy all"
msgstr "Скопіювати все"

#: passwordVaultMenu.js:770
msgid "Edit service"
msgstr "Редагувати сервіс"

#: passwordVaultMenu.js:905
msgid "Extra"
msgstr "Додатково"

#: passwordVaultMenu.js:974
msgid "Warning: value has hidden leading or trailing characters"
msgstr ""
"Увага: значення містить приховані пробіли або недруковані символи на початку "
"чи в кінці"

#: passwordVaultMenu.js:1021
msgid "Edit value"
msgstr "Редагувати значення"

#: passwordVaultMenu.js:1081
msgid "Failed to save the password vault."
msgstr "Не вдалося зберегти сховище паролів."

#: prefs.js:35 prefs.js:428
msgid "UI"
msgstr "Інтерфейс"

#: prefs.js:36 prefs.js:429
msgid "Behavior"
msgstr "Поведінка"

#: prefs.js:37 prefs.js:435
msgid "Search"
msgstr "Пошук"

#: prefs.js:38 prefs.js:431
msgid "Limits"
msgstr "Обмеження"

#: prefs.js:39 prefs.js:430
msgid "Exclusion"
msgstr "Виключення"

#: prefs.js:40 prefs.js:432
msgid "Topbar"
msgstr "Верхня панель"

#: prefs.js:41 prefs.js:433
msgid "Notifications"
msgstr "Сповіщення"

#: prefs.js:42 prefs.js:434
msgid "Shortcuts"
msgstr "Клавіатурні скорочення"

#: prefs.js:64
msgid "History Size"
msgstr "Розмір історії"

#: prefs.js:65
msgid "Maximum number of entries to keep in clipboard history"
msgstr "Максимальна кількість записів в історії буфера обміну"

#: prefs.js:74
msgid "Preview Size"
msgstr "Розмір попереднього перегляду"

#: prefs.js:75
msgid ""
"How much of each entry the history menu shows. Long single-line text is cut "
"to the width of the row"
msgstr "Скільки кожного запису показує меню історії. Довгий текст в один рядок обрізається за шириною рядка"

#: prefs.js:84
msgid "Max cache file size (MB)"
msgstr "Максимальний розмір файлу кешу (МБ)"

#: prefs.js:85
msgid "Maximum disk space used for caching clipboard data"
msgstr "Максимальний обсяг диску для кешування даних буфера обміну"

#: prefs.js:94
msgid "Number of characters in top bar"
msgstr "Кількість символів на верхній панелі"

#: prefs.js:95
msgid "Length of the clipboard content preview shown in the panel"
msgstr "Довжина попереднього перегляду вмісту буфера обміну на панелі"

#: prefs.js:104
msgid "What to show in top bar"
msgstr "Що показувати на верхній панелі"

#: prefs.js:109
msgid "Remove down arrow in top bar"
msgstr "Прибрати стрілку вниз на верхній панелі"

#: prefs.js:110
msgid "Hide the dropdown arrow next to the clipboard indicator"
msgstr "Сховати стрілку випадаючого списку біля індикатора буфера обміну"

#: prefs.js:114
msgid "Blink icon on copy"
msgstr "Мерехтіти піктограмою при копіюванні"

#: prefs.js:115
msgid "Briefly flash the indicator icon when something is copied"
msgstr "Короткочасно мерехтіти піктограмою індикатора при копіюванні"

#: prefs.js:119
msgid "Cache only pinned items"
msgstr "Кешувати лише пришпилені записи"

#: prefs.js:120
msgid "Only save pinned (favorite) entries to disk"
msgstr "Зберігати на диску лише пришпилені (обрані) записи"

#: prefs.js:124
msgid "Show notification on copy"
msgstr "Показувати сповіщення при копіюванні"

#: prefs.js:125
msgid "Display a notification each time text is copied"
msgstr "Показувати сповіщення щоразу, коли текст скопійовано"

#: prefs.js:129
msgid "Show notification on cycle"
msgstr "Показувати сповіщення при перемиканні"

#: prefs.js:130
msgid "Display a notification when cycling through entries with shortcuts"
msgstr ""
"Показувати сповіщення під час перемикання записів клавіатурними скороченнями"

#: prefs.js:134
msgid "Show notification on Clear History"
msgstr "Показувати сповіщення при очищенні історії"

#: prefs.js:135
msgid "Display a notification when clipboard history is cleared"
msgstr "Показувати сповіщення, коли історію буфера обміну очищено"

#: prefs.js:139
msgid "Prompt for confirmation on Clear History"
msgstr "Запитувати підтвердження при очищенні історії"

#: prefs.js:140
msgid "Ask before deleting all clipboard entries"
msgstr "Запитувати перед видаленням усіх записів буфера обміну"

