msgid "Number of characters in top bar"
msgstr "Кількість символів на верхній панелі"

#: prefs.js:73
msgid "Length of the clipboard content preview shown in the panel"
msgstr "Довжина попереднього перегляду вмісту буфера обміну на панелі"

#: prefs.js:82
msgid "What to show in top bar"
msgstr "Що показувати на верхній панелі"

#: prefs.js:87
msgid "Remove down arrow in top bar"
msgstr "Прибрати стрілку вниз на верхній панелі"

#: prefs.js:88
msgid "Hide the dropdown arrow next to the clipboard indicator"
msgstr "Сховати стрілку випадаючого списку біля індикатора буфера обміну"

#: prefs.js:92
msgid "Blink icon on copy"
msgstr "Мерехтіти піктограмою при копіюванні"

#: prefs.js:93
msgid "Briefly flash the indicator icon when something is copied"
msgstr "Короткочасно мерехтіти піктограмою індикатора при копіюванні"

#: prefs.js:97
msgid "Cache only pinned items"
msgstr "Кешувати лише пришпилені записи"

#: prefs.js:98
msgid "Only save pinned (favorite) entries to disk"
msgstr "Зберігати на диску лише пришпилені (обрані) записи"

#: prefs.js:102
msgid "Show notification on copy"
msgstr "Показувати сповіщення при копіюванні"

#: prefs.js:103
msgid "Display a notification each time text is copied"
msgstr "Показувати сповіщення щоразу, коли текст скопійовано"

#: prefs.js:107
msgid "Show notification on cycle"
msgstr "Показувати сповіщення при перемиканні"

#: prefs.js:108
msgid "Display a notification when cycling through entries with shortcuts"
msgstr ""
"Показувати сповіщення під час перемикання записів клавіатурними скороченнями"

#: prefs.js:112
msgid "Show notification on Clear History"
msgstr "Показувати сповіщення при очищенні історії"

#: prefs.js:113
msgid "Display a notification when clipboard history is cleared"
msgstr "Показувати сповіщення, коли історію буфера обміну очищено"

#: prefs.js:117
msgid "Prompt for confirmation on Clear History"
msgstr "Запитувати підтвердження при очищенні історії"

#: prefs.js:118
msgid "Ask before deleting all clipboard entries"
msgstr "Запитувати перед видаленням усіх записів буфера обміну"

#: prefs.js:122
msgid "Prompt before deleting pinned item"
msgstr "Запитувати перед видаленням пришпиленого запису"

#: prefs.js:123
msgid "Ask for confirmation before deleting a pinned item"
msgstr "Запитувати підтвердження перед видаленням пришпиленого запису"

#: prefs.js:127
msgid "Remove spaces around text"
msgstr "Прибирати пробіли навколо тексту"

#: prefs.js:128
msgid "Strip leading and trailing spaces from text entries on copy"
msgstr "Обрізати початкові й кінцеві пробіли текстових записів при копіюванні"

#: prefs.js:132
msgid "Remove line breaks around text"
msgstr "Прибирати перенесення рядків навколо тексту"

#: prefs.js:133
msgid "Strip leading and trailing line breaks from text entries on copy"
msgstr ""
"Обрізати початкові й кінцеві перенесення рядків текстових записів при "
"копіюванні"

#: prefs.js:137
msgid "Move item to the top after selection"
msgstr "Переміщувати вибраний запис нагору"

#: prefs.js:138
msgid "When selecting an entry, bring it to the top of the history"
msgstr "Під час вибору запису переміщувати його нагору історії"

#: prefs.js:142
msgid "Keep selected entry after Clear History"
msgstr "Зберігати вибраний запис після очищення історії"

#: prefs.js:143
msgid ""
"The currently active clipboard entry will not be removed when clearing "
"history"
msgstr ""
"Поточний активний запис буфера обміну не буде видалено під час очищення "
"історії"

#: prefs.js:147
msgid "Place the pinned section on the bottom"
msgstr "Розмістити секцію пришпилених знизу"

#: prefs.js:148
msgid "Move the pinned section to the bottom of the menu. Requires re-login"
msgstr "Перемістити секцію пришпилених униз меню. Потрібен повторний вхід"

#: prefs.js:152
msgid "Show Search Bar"
msgstr "Показувати рядок пошуку"

#: prefs.js:153
msgid "Display a search field at the top of the clipboard menu"
msgstr "Показувати поле пошуку вгорі меню буфера обміну"

#: prefs.js:156
msgid "Show Private Mode"
msgstr "Показувати приватний режим"

#: prefs.js:157
msgid "Display the private mode toggle in the clipboard menu"
msgstr "Показувати перемикач приватного режиму в меню буфера обміну"

#: prefs.js:160
msgid "Show Settings Button"
msgstr "Показувати кнопку параметрів"

#: prefs.js:161
msgid "Display a shortcut to these settings in the clipboard menu"
msgstr "Показувати перехід до цих параметрів у меню буфера обміну"

#: prefs.js:164
msgid "Show Clear History Button"
msgstr "Показувати кнопку очищення історії"

#: prefs.js:165
msgid "Display the clear history button in the clipboard menu"
msgstr "Показувати кнопку очищення історії в меню буфера обміну"

#: prefs.js:169
msgid "Clear clipboard history on system reboot"
msgstr "Очищати історію буфера обміну під час перезапуску системи"

#: prefs.js:170
msgid "Delete all cached clipboard entries when the system starts"
msgstr "Видаляти всі кешовані записи буфера обміну під час запуску системи"

#: prefs.js:174
msgid "Paste on select"
msgstr "Вставляти під час вибору"

#: prefs.js:175
msgid "Automatically paste the entry into the active window when selected"
msgstr "Автоматично вставляти запис в активне вікно під час вибору"

#: prefs.js:179
msgid "Open menu at cursor"
msgstr "Відкривати меню біля курсора"

#: prefs.js:180
msgid "When using the keyboard shortcut, open the menu at the cursor position"
msgstr ""
"Під час використання клавіатурного скорочення відкривати меню в позиції "
"курсора"

#: prefs.js:185
msgid "Show the delete button on each item"
msgstr "Показувати кнопку видалення на кожному записі"

#: prefs.js:189
msgid "Tag"
msgstr "Тег"

#: prefs.js:190
msgid "Show the tag button on each item"
msgstr "Показувати кнопку тегу на кожному записі"

#: prefs.js:195
msgid "Show the paste button on each item"
msgstr "Показувати кнопку вставлення на кожному записі"

#: prefs.js:199
msgid "Pin"
msgstr "Пришпилити"

#: prefs.js:200
msgid "Show the pin/favorite button on each item"
msgstr "Показувати кнопку пришпилення/обраного на кожному записі"

#: prefs.js:205
msgid "Show the edit button on each text item"
msgstr "Показувати кнопку редагування на кожному текстовому записі"

#: prefs.js:209
msgid "Preview"
msgstr "Перегляд"

#: prefs.js:210
msgid "Show the preview button on each image item"
msgstr "Показувати кнопку перегляду на кожному записі-зображенні"

#: prefs.js:214
msgid "Preview on hover"
msgstr "Перегляд при наведенні"

#: prefs.js:215
msgid "Show the image preview while hovering over the preview button"
msgstr "Показувати перегляд зображення під час наведення на кнопку перегляду"

#: prefs.js:219
msgid "Cache images"
msgstr "Кешувати зображення"

#: prefs.js:220
msgid "Save copied images to clipboard history"
msgstr "Зберігати скопійовані зображення в історії буфера обміну"

#: prefs.js:225
msgid "Excluded Apps"
msgstr "Виключені програми"

#: prefs.js:226
msgid "Content copied will not be saved while these apps are in focus"
msgstr "Скопійований вміст не зберігатиметься, поки ці програми у фокусі"

#: prefs.js:237
msgid "Case-sensitive"
msgstr "З урахуванням регістру"

#: prefs.js:238
msgid "Match uppercase and lowercase letters exactly when searching"
msgstr "Точно враховувати великі й малі літери під час пошуку"

#: prefs.js:242
msgid "Regular expressions"
msgstr "Регулярні вирази"

#: prefs.js:243
msgid "Allow regular expressions to filter clipboard entries"
msgstr "Дозволити регулярні вирази для фільтрації записів буфера обміну"

#: prefs.js:256
msgid "Clear clipboard history on interval"
msgstr "Очищати історію буфера обміну за інтервалом"

#: prefs.js:257
msgid "Automatically clear clipboard history at a recurring interval"
msgstr "Автоматично очищати історію буфера обміну із заданим інтервалом"

#: prefs.js:261
msgid "History clear interval (in minutes)"
msgstr "Інтервал очищення історії (у хвилинах)"

#: prefs.js:274
msgid "Colorize clipboard content"
msgstr "Розфарбовувати вміст буфера обміну"

#: prefs.js:297
msgid ""
"Highlight clipboard entries by type (files, URLs, emails, colors, masked "
"items)"
msgstr ""
"Виділяти записи буфера обміну за типом (файли, URL, електронні листи, "
"кольори, елементи з маскою)"

#: prefs.js:279
msgid "Fetch YouTube video titles"
msgstr "Отримувати назви відео YouTube"

#: prefs.js:280
msgid ""
"Warning: enabling this sends YouTube links copied to the clipboard "
"(clipboard data) to a third party — https://www.youtube.com/oembed"
msgstr ""
"Попередження: увімкнувши цю опцію, скопійовані в буфер обміну посилання "
"YouTube (дані буфера обміну) передаються третій стороні — https://www."
"youtube.com/oembed"

#: prefs.js:284
msgid "Enable password vault"
msgstr "Увімкнути сховище паролів"

#: prefs.js:285
msgid "Show the vault section and open it with right-click or the hotkey"
msgstr ""
"Показувати розділ сховища та відкривати його правою кнопкою миші або гарячою "
"клавішею"

#: prefs.js:289
msgid "Add vault copies to clipboard history"
msgstr "Додавати копії зі сховища в історію буфера обміну"

#: prefs.js:290
msgid ""
"Everything copied from the vault lands in the visible clipboard list. "
"WARNING: this stores passwords and logins in plain text — keep it off unless "
"you understand the risk"
msgstr ""
"Усе, що копіюється зі сховища, потрапляє у видимий список буфера обміну. "
"УВАГА: паролі та логіни зберігатимуться у відкритому вигляді — тримайте "
"опцію вимкненою, якщо не розумієте ризику"

#: prefs.js:294
msgid "Password Vault File Path"
msgstr "Шлях до файлу сховища паролів"

#: prefs.js:313
msgid "Browse…"
msgstr "Огляд…"

#: prefs.js:592
msgid "Select the password vault file"
msgstr "Виберіть файл сховища паролів"

#: prefs.js:303
msgid "Use 7z vault format"
msgstr "Формат архіву 7z"

#: prefs.js:304
msgid ""
"The 7z format (AES-256) encrypts the archive headers, hiding the stored file "
"name and sizes; it can be opened only with 7-Zip. ZIP stays portable but "
"reveals them. An existing vault is converted, and its file renamed to match "
"(.zip ↔ .7z), the next time it is opened with the master password."
msgstr "Формат 7z (AES-256) шифрує заголовки архіву, приховуючи ім'я внутрішнього файлу та розміри; відкрити його можна лише засобами 7-Zip. ZIP залишається переносним, але розкриває ім'я файлу та розмір. Наявне сховище конвертується, а файл перейменовується відповідно до формату (.zip ↔ .7z) під час наступного відкриття з майстер-паролем."

#: prefs.js:340
msgid "Pin last used service card"
msgstr "Закріплювати картку останнього використаного сервісу"

#: prefs.js:341
msgid "Show the last used service as a card at the top of the vault"
msgstr "Показувати останній використаний сервіс карткою вгорі сховища"

#: prefs.js:345
msgid "Hide services in the 'All' view"
msgstr "Приховувати сервіси в режимі «Усі»"

#: prefs.js:346
msgid "When 'All' is selected, show nothing until you search (extra privacy)"
msgstr ""
"Коли вибрано «Усі», нічого не показувати, доки не почнете пошук (додаткова "
"приватність)"

#: prefs.js:350
msgid "Hidden-field edge warning"
msgstr "Попередження про крайові символи в прихованих полях"

#: prefs.js:351
msgid ""
"Show a ⚠️ icon when a hidden password or field starts or ends with a space, "
"line break or non-printable character. Catches invisible paste typos (Ctrl+V "
"artifact, stray space), but the icon also reveals metadata about the secret "
"value to anyone viewing the screen, e.g. during screen sharing. Off by "
"default."
msgstr ""
"Показувати значок ⚠️, якщо прихований пароль або поле починається чи "
"закінчується пробілом, перенесенням рядка або недрукованим символом. "
"Допомагає помітити невидимі артефакти вставки (зайвий пробіл, Ctrl+V), але "
"значок також розкриває відомості про секретне значення тим, хто бачить "
"екран, наприклад під час демонстрації. Вимкнено за замовчуванням."

#: prefs.js:355
msgid "When to ask for the master password"
msgstr "Коли запитувати master-пароль"

#: prefs.js:356
msgid "How often the password vault requests the master password"
msgstr "Як часто сховище паролів запитує master-пароль"

#: prefs.js:361
msgid "Reset vault search on close"
msgstr "Скидати пошук сховища при закритті"

#: prefs.js:362
msgid ""
"Clear the search filter in the password vault when the vault menu closes"
msgstr "Очищати пошуковий фільтр сховища паролів при закритті його меню"

#: prefs.js:366
msgid "Clear copied vault secrets from clipboard"
msgstr "Очищати буфер обміну після копіювання секрету зі сховища"

#: prefs.js:367
msgid ""
"Automatically remove a value copied from the password vault from the "
"clipboard after a short delay — only when it still matches the copied value"
msgstr ""
"Автоматично видаляти з буфера обміну значення, скопійоване зі сховища "
"паролів, через коротку затримку — лише якщо воно все ще збігається зі "
"скопійованим значенням"

#: prefs.js:371
msgid "Clipboard clear delay (seconds)"
msgstr "Затримка очищення буфера обміну (секунди)"

#: prefs.js:391
msgid "Item Actions"
msgstr "Дії з записами"

#: prefs.js:392
msgid "Password Vault Settings"
msgstr "Параметри сховища паролів"

#: prefs.js:395
msgid "Required: 7-Zip (7z or 7za)"
msgstr "Потрібно: 7-Zip (7z або 7za)"

#: prefs.js:396
msgid ""
"The vault is an encrypted archive (ZIP or 7z). To open and save it the "
"extension needs 7-Zip: install p7zip-full (7z) or p7zip (7za). Keep the "
"archive file in a protected location."
msgstr ""
"Храмінник — це зашифрований архів (ZIP або 7z). Щоб відкривати та зберігати "
"його, розширення використовує архіватор 7-Zip (7z або 7za). Тримайте файл "
"архіву в захищеному місці."

#: prefs.js:539
msgid "Icon"
msgstr "Піктограма"

#: prefs.js:540
msgid "Clipboard Content"
msgstr "Вміст буфера обміну"

#: prefs.js:541
msgid "Both"
msgstr "Обидва"

#: prefs.js:542
msgid "Neither"
msgstr "Жодне"

#: prefs.js:553
msgid "Once per session"
msgstr "Один раз за сеанс"

#: prefs.js:554
msgid "Every time the vault is opened"
msgstr "При кожному відкритті сховища"

#: prefs.js:555
msgid "After system sleep"
msgstr "Після сну системи"

#: prefs.js:581
msgid "No vault archive at this path yet"
msgstr "За цим шляхом сховища ще немає"

#: prefs.js:582
msgid "It will be created in 7z format."
msgstr "Воно буде створено у форматі 7z."

#: prefs.js:582
msgid "It will be created in ZIP format."
msgstr "Воно буде створено у форматі ZIP."

#: prefs.js:585
msgid "The vault file is empty or not a readable archive"
msgstr "Файл сховища порожній або не є читабельним архівом"

#: prefs.js:586
msgid ""
"It is 0 bytes or its content is not ZIP/7z — restore it from the .bak file "
"or a backup."
msgstr "Це 0 байт або вміст не ZIP/7z — відновіть його з файлу .bak або резервної копії."

#: prefs.js:590
msgid "Detected a 7z archive in a .zip file"
msgstr "Виявлено архів 7z у файлі .zip"

#: prefs.js:591
msgid "Detected a ZIP archive in a .7z file"
msgstr "Виявлено архів ZIP у файлі .7z"

#: prefs.js:592
msgid ""
"The archive is renamed to match its content the next time the vault is "
"opened with the master password."
msgstr "Файл буде перейменовано відповідно до вмісту під час наступного відкриття сховища з майстер-паролем."

#: prefs.js:595
msgid "Detected a 7z archive"
msgstr "Виявлено архів 7z"

#: prefs.js:595
msgid "Detected a ZIP archive"
msgstr "Виявлено архів ZIP"

#: prefs.js:597
msgid "It will be converted to 7z the next time it is opened."
msgstr "Воно буде перетворено в 7z під час наступного відкриття."

#: prefs.js:597
msgid "It will be converted to ZIP the next time it is opened."
msgstr "Воно буде перетворено в ZIP під час наступного відкриття."

#: prefs.js:639
msgid "Toggle the menu"
msgstr "Перемкнути меню"

#: prefs.js:640
msgid "Toggle Password Vault"
msgstr "Перемкнути сховище паролів"

#: prefs.js:642
msgid "Previous entry"
msgstr "Попередній запис"

#: prefs.js:643
msgid "Next entry"
msgstr "Наступний запис"

#: prefs.js:648
msgid "Enable shortcuts"
msgstr "Увімкнути клавіатурні скорочення"

#: prefs.js:673
msgid "Disabled"
msgstr "Вимкнено"

#: prefs.js:682
msgid "Enter shortcut"
msgstr "Введіть клавіатурне скорочення"

#: prefs.js:769
msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Назва класу вікна, напр. \"KeePassXC\""

#: prefs.js:781
msgid "Choose from installed applications"
msgstr "Обрати зі встановлених програм"

#: prefs.js:798
