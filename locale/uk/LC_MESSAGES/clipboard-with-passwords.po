#: passwordVaultDialog.js:646 passwordVault.js:1161
msgid "Untitled"
msgstr "Без назви"

#: passwordVaultDialog.js:831
msgid "Delete service"
msgstr "Видалити сервіс"

#: passwordVaultDialog.js:837
msgid "Are you sure you want to permanently delete this service?"
msgstr "Справді остаточно видалити цей сервіс?"

#: passwordVaultDialog.js:865
msgid "Label"
msgstr "Назва"

#: passwordVaultDialog.js:868
msgid "Value"
msgstr "Значення"

#: passwordVaultDialog.js:881 passwordVaultDialog.js:917
#: passwordVaultMenu.js:989 passwordVaultMenu.js:999
