#: passwordVault.js:461 passwordVault.js:605
msgid "The password vault path points to a directory."
msgstr "Шлях до сховища паролів вказує на каталог."

#: passwordVault.js:464 passwordVault.js:609
msgid "The password vault file is read-only and cannot be updated."
msgstr "Файл сховища паролів лише для читання і не може бути оновлений."

#: passwordVault.js:479
msgid "The vault archive is too large."
msgstr "Архів сховища завеликий."

#: passwordVault.js:484 passwordVault.js:502 passwordVault.js:692
#: passwordVault.js:721
msgid "7-Zip (7z, 7za or 7zz) is not installed."
msgstr "7-Zip (7z, 7za або 7zz) не встановлено."

#: passwordVault.js:484 passwordVault.js:502 passwordVault.js:692
#: passwordVault.js:721
msgid "Install 7-Zip (7zip or p7zip-full) and restart the shell."
msgstr "Встановіть 7-Zip (7zip або p7zip-full) і перезапустіть оболонку."

#: passwordVault.js:531 passwordVault.js:579
msgid "The vault archive contains too much data."
msgstr "Архів сховища містить забагато даних."

#: passwordVault.js:538
msgid "The vault archive does not contain valid JSON data."
msgstr "Архів сховища не містить коректних даних JSON."

#: passwordVault.js:577 passwordVault.js:806
msgid "7-Zip did not finish in time (timeout). Try again."
msgstr "7-Zip не встиг завершити роботу (таймаут). Спробуйте ще раз."

#: passwordVault.js:588
msgid "The password vault is locked."
msgstr "Сховище паролів заблоковано."

#: passwordVault.js:839
msgid "Cannot create the password vault directory."
msgstr "Не вдалося створити каталог сховища паролів."

#: passwordVault.js:843
msgid "The password vault directory is not writable."
msgstr "Каталог сховища паролів недоступний для запису."

#: passwordVault.js:977
msgid "Wrong password or corrupted vault archive."
msgstr "Неправильний пароль або пошкоджений архів сховища."

#: passwordVault.js:983
msgid ""
"The vault file is empty (0 bytes). Restore it from the .bak file or a backup."
msgstr "Файл сховища порожній (0 байт). Відновіть його з файлу .bak або резервної копії."

#: passwordVault.js:985
msgid ""
"A previous version exists as a .bak file next to the archive — restore it "
"manually."
msgstr "Поруч з архівом є попередня версія у файлі .bak — відновіть її вручну."

#: passwordVault.js:1103 passwordVault.js:1106 passwordVault.js:1232
#: passwordVault.js:1255
msgid "The vault archive contains invalid data."
msgstr "Архів сховища містить недопустимі дані."

#: passwordVault.js:1109
msgid "The vault contains too many items (max 1000)."
msgstr "Сховище містить забагато записів (максимум 1000)."

#: passwordVault.js:1118
msgid "The vault archive uses an unsupported format version."
msgstr "Архів сховища використовує непідтримувану версію формату."

#: passwordVault.js:1149
msgid "A vault item contains a field that is too long."
msgstr "Запис сховища містить надто довге поле."

#: passwordVault.js:1194
msgid "A vault item contains too many extra fields."
msgstr "Запис сховища містить забагато додаткових полів."

#: passwordVaultMenu.js:196
msgid "All"
msgstr "Усі"

#: passwordVaultMenu.js:248
