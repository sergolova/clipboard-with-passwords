msgid "Strip leading and trailing spaces from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие пробелы из текстовых записей при копировании"

#: prefs.js:132
msgid "Remove line breaks around text"
msgstr "Удалять переводы строк вокруг текста"

#: prefs.js:133
msgid "Strip leading and trailing line breaks from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие переводы строк из текстовых записей при "
"копировании"

#: prefs.js:137
msgid "Move item to the top after selection"
msgstr "Переместить запись в начало после выделения"

#: prefs.js:138
msgid "When selecting an entry, bring it to the top of the history"
msgstr "При выборе записи поднимать её в начало истории"

#: prefs.js:142
msgid "Keep selected entry after Clear History"
msgstr "Не очищать выбранную запись после очистки истории"

#: prefs.js:143
msgid ""
"The currently active clipboard entry will not be removed when clearing "
"history"
msgstr "Текущая активная запись буфера обмена не будет удалена при очистке истории"

#: prefs.js:147
msgid "Place the pinned section on the bottom"
msgstr "Размещать закреплённый раздел внизу"

#: prefs.js:148
msgid "Move the pinned section to the bottom of the menu. Requires re-login"
msgstr "Переместить закреплённый раздел вниз меню. Требуется повторный вход"

#: prefs.js:152
msgid "Show Search Bar"
msgstr "Показывать строку поиска"

#: prefs.js:153
msgid "Display a search field at the top of the clipboard menu"
msgstr "Показывать поле поиска в верхней части меню буфера"

#: prefs.js:156
msgid "Show Private Mode"
msgstr "Показывать приватный режим"

#: prefs.js:157
msgid "Display the private mode toggle in the clipboard menu"
msgstr "Показывать переключатель приватного режима в меню буфера"

#: prefs.js:160
msgid "Show Settings Button"
msgstr "Показывать кнопку настроек"

#: prefs.js:161
msgid "Display a shortcut to these settings in the clipboard menu"
msgstr "Показывать быстрый доступ к настройкам в меню буфера"

#: prefs.js:164
msgid "Show Clear History Button"
msgstr "Показывать кнопку очистки истории"

#: prefs.js:165
msgid "Display the clear history button in the clipboard menu"
msgstr "Показывать кнопку очистки истории в меню буфера"

#: prefs.js:169
msgid "Clear clipboard history on system reboot"
