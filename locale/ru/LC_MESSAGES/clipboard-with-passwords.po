#: passwordVault.js:458 passwordVault.js:602
msgid "The password vault file is read-only and cannot be updated."
msgstr ""
"Файл хранилища паролей доступен только для чтения и не может быть обновлён."

#: passwordVault.js:473
msgid "The vault archive is too large."
msgstr "Архив хранилища слишком большой."

#: passwordVault.js:478 passwordVault.js:496 passwordVault.js:685
#: passwordVault.js:714
msgid "7-Zip (7z, 7za or 7zz) is not installed."
msgstr "7-Zip (7z, 7za или 7zz) не установлен."

#: passwordVault.js:478 passwordVault.js:496 passwordVault.js:685
#: passwordVault.js:714
msgid "Install 7-Zip (7zip or p7zip-full) and restart the shell."
msgstr "Установите 7-Zip (7zip или p7zip-full) и перезапустите оболочку."

#: passwordVault.js:525 passwordVault.js:572
msgid "The vault archive contains too much data."
msgstr "Архив хранилища содержит слишком много данных."

#: passwordVault.js:532
msgid "The vault archive does not contain valid JSON data."
msgstr "Архив хранилища не содержит корректных данных JSON."

#: passwordVault.js:570 passwordVault.js:799
msgid "7-Zip did not finish in time (timeout). Try again."
msgstr "7-Zip не завершил работу вовремя (таймаут). Попробуйте ещё раз."

#: passwordVault.js:581
msgid "The password vault is locked."
msgstr "Хранилище паролей заблокировано."

#: passwordVault.js:832
msgid "Cannot create the password vault directory."
msgstr "Не удалось создать каталог хранилища паролей."

#: passwordVault.js:836
msgid "The password vault directory is not writable."
msgstr "Каталог хранилища паролей недоступен для записи."

#: passwordVault.js:970
msgid "Wrong password or corrupted vault archive."
msgstr "Неверный пароль или повреждённый архив хранилища."

#: passwordVault.js:976
msgid ""
"The vault file is empty (0 bytes). Restore it from the .bak file or a backup."
msgstr "Файл хранилища пуст (0 байт). Восстановите его из файла .bak или резервной копии."

#: passwordVault.js:978
msgid ""
"A previous version exists as a .bak file next to the archive — restore it "
"manually."
msgstr "Рядом с архивом есть предыдущая версия в файле .bak — восстановите её вручную."

#: passwordVault.js:1081 passwordVault.js:1084 passwordVault.js:1210
#: passwordVault.js:1232
msgid "The vault archive contains invalid data."
msgstr "Архив хранилища содержит недопустимые данные."

#: passwordVault.js:1087
msgid "The vault contains too many items (max 1000)."
msgstr "Хранилище содержит слишком много записей (максимум 1000)."

#: passwordVault.js:1096
msgid "The vault archive uses an unsupported format version."
msgstr "Архив хранилища использует неподдерживаемую версию формата."

#: passwordVault.js:1127
msgid "A vault item contains a field that is too long."
msgstr "Запись хранилища содержит слишком длинное поле."

#: passwordVault.js:1172
msgid "A vault item contains too many extra fields."
msgstr "Запись хранилища содержит слишком много дополнительных полей."

