msgstr "Запрашивать подтверждение перед удалением закреплённого элемента"

#: prefs.js:126
msgid "Remove spaces around text"
msgstr "Удалить пробелы в тексте"

#: prefs.js:127
msgid "Strip leading and trailing spaces from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие пробелы из текстовых записей при копировании"

#: prefs.js:131
msgid "Remove line breaks around text"
msgstr "Удалять переводы строк вокруг текста"

#: prefs.js:132
msgid "Strip leading and trailing line breaks from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие переводы строк из текстовых записей при "
"копировании"

#: prefs.js:136
msgid "Move item to the top after selection"
msgstr "Переместить запись в начало после выделения"

#: prefs.js:137
msgid "When selecting an entry, bring it to the top of the history"
msgstr "При выборе записи поднимать её в начало истории"

#: prefs.js:141
msgid "Keep selected entry after Clear History"
msgstr "Не очищать выбранную запись после очитски истории"

#: prefs.js:142
msgid ""
"The currently active clipboard entry will not be removed when clearing "
"history"
msgstr ""

#: prefs.js:146
msgid "Place the pinned section on the bottom"
msgstr "Размещать закреплённый раздел внизу"

#: prefs.js:147
msgid "Move the pinned section to the bottom of the menu. Requires re-login"
msgstr "Переместить закреплённый раздел вниз меню. Требуется повторный вход"

#: prefs.js:151
msgid "Show Search Bar"
msgstr "Показывать строку поиска"

#: prefs.js:152
msgid "Display a search field at the top of the clipboard menu"
msgstr "Показывать поле поиска в верхней части меню буфера"

#: prefs.js:155
msgid "Show Private Mode"
msgstr "Показывать приватный режим"

#: prefs.js:156
msgid "Display the private mode toggle in the clipboard menu"
msgstr "Показывать переключатель приватного режима в меню буфера"

#: prefs.js:159
msgid "Show Settings Button"
msgstr "Показывать кнопку настроек"

#: prefs.js:160
msgid "Display a shortcut to these settings in the clipboard menu"
msgstr "Показывать быстрый доступ к настройкам в меню буфера"

#: prefs.js:163
msgid "Show Clear History Button"
msgstr "Показывать кнопку очистки истории"

#: prefs.js:164
msgid "Display the clear history button in the clipboard menu"
msgstr "Показывать кнопку очистки истории в меню буфера"

#: prefs.js:168
msgid "Clear clipboard history on system reboot"
msgstr "История буфера обмена очищена"

#: prefs.js:169
msgid "Delete all cached clipboard entries when the system starts"
msgstr "Удалять все кэшированные записи буфера при запуске системы"

#: prefs.js:173
msgid "Paste on select"
msgstr "Вставка при выделении"

#: prefs.js:174
msgid "Automatically paste the entry into the active window when selected"
msgstr "Автоматически вставлять запись в активное окно при выборе"

#: prefs.js:178
msgid "Open menu at cursor"
msgstr "Открывать меню у курсора"

#: prefs.js:179
msgid "When using the keyboard shortcut, open the menu at the cursor position"
msgstr "При использовании горячей клавиши открывать меню у позиции курсора"

#: prefs.js:184
msgid "Show the delete button on each item"
msgstr "Показывать кнопку удаления на каждом элементе"

#: prefs.js:188
msgid "Tag"
msgstr "Метка"

#: prefs.js:189
msgid "Show the tag button on each item"
msgstr "Показывать кнопку метки на каждом элементе"

#: prefs.js:194
msgid "Show the paste button on each item"
msgstr "Показывать кнопку вставки на каждом элементе"

#: prefs.js:198
msgid "Pin"
msgstr "Закрепить"

#: prefs.js:199
msgid "Show the pin/favorite button on each item"
msgstr "Показывать кнопку закрепления/избранного на каждом элементе"

#: prefs.js:204
msgid "Show the edit button on each text item"
msgstr "Показывать кнопку редактирования на каждом текстовом элементе"

#: prefs.js:208
msgid "Preview"
msgstr "Предпросмотр"

#: prefs.js:209
msgid "Show the preview button on each image item"
msgstr "Показывать кнопку предпросмотра на каждом элементе-изображении"

#: prefs.js:213
msgid "Preview on hover"
msgstr "Предпросмотр при наведении"

#: prefs.js:214
msgid "Show the image preview while hovering over the preview button"
msgstr ""
"Показывать предпросмотр изображения при наведении на кнопку предпросмотра"

#: prefs.js:218
msgid "Cache images"
msgstr "Кэшировать изображения"

#: prefs.js:219
msgid "Save copied images to clipboard history"
msgstr "Сохранять скопированные изображения в историю буфера"

#: prefs.js:224
msgid "Excluded Apps"
msgstr "Исключённые приложения"

#: prefs.js:225
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"Скопированное содержимое не будет сохраняться, пока активны эти "
"приложенияСкопированное содержимое не будет сохранено, пока эти приложения "
"находятся в фокусе"

#: prefs.js:236
msgid "Case-sensitive"
msgstr "С учётом регистра"

#: prefs.js:237
msgid "Match uppercase and lowercase letters exactly when searching"
msgstr "Точно различать строчные и прописные буквы при поиске"

#: prefs.js:241
msgid "Regular expressions"
msgstr "Регулярные выражения"

#: prefs.js:242
msgid "Allow regular expressions to filter clipboard entries"
msgstr "Разрешить регулярные выражения для фильтрации записей буфера"

#: prefs.js:255
msgid "Clear clipboard history on interval"
msgstr "Очищать историю буфера по интервалу"

#: prefs.js:256
msgid "Automatically clear clipboard history at a recurring interval"
msgstr "Автоматически очищать историю буфера через заданный интервал"

#: prefs.js:260
msgid "History clear interval (in minutes)"
msgstr "Интервал очистки истории (в минутах)"

#: prefs.js:273
msgid "Colorize clipboard content"
msgstr "Раскрашивать содержимое буфера"

#: prefs.js:274
msgid ""
"Highlight clipboard entries by type (files, URLs, emails, colors, passwords)"
msgstr ""
"Подсвечивать записи буфера по типу (файлы, ссылки, email, цвета, пароли)"

#: prefs.js:278
msgid "Fetch YouTube video titles"
msgstr "Получать названия видео YouTube"

#: prefs.js:279
msgid ""
"Warning: enabling this sends YouTube links copied to the clipboard "
"(clipboard data) to a third party — https://www.youtube.com/oembed"
msgstr ""
"Предупреждение: при включении этой опции скопированные в буфер обмена ссылки "
"YouTube (данные буфера обмена) передаются третьей стороне — https://www."
"youtube.com/oembed"

#: prefs.js:283
msgid "Enable password vault"
msgstr "Включить хранилище паролей"

#: prefs.js:284
msgid "Show the vault section and open it with right-click or the hotkey"
msgstr ""
"Показывать раздел хранилища и открывать его правой кнопкой мыши или горячей "
"клавишей"

#: prefs.js:288
msgid "Add vault copies to clipboard history"
msgstr "Добавлять копии из хранилища в историю буфера обмена"

#: prefs.js:289
msgid ""
"Everything copied from the vault lands in the visible clipboard list. "
"WARNING: this stores passwords and logins in plain text — keep it off unless "
"you understand the risk"
msgstr ""
"Всё, что копируется из хранилища, попадает в видимый список буфера обмена. "
"ВНИМАНИЕ: пароли и логины будут храниться в открытом виде — держите опцию "
"выключенной, если не понимаете риска"

#: prefs.js:293
msgid "Password Vault File Path"
msgstr "Путь к файлу хранилища паролей"

#: prefs.js:301
msgid "Pin last used service card"
msgstr "Закреплять карточку последнего сервиса"

#: prefs.js:302
msgid "Show the last used service as a card at the top of the vault"
msgstr ""
"Показывать последний использованный сервис карточкой в верхней части "
"хранилища"

#: prefs.js:306
msgid "Hide services in the 'All' view"
msgstr "Скрывать сервисы в режиме «Все»"

#: prefs.js:307
msgid "When 'All' is selected, show nothing until you search (extra privacy)"
msgstr ""
"При выборе режима «Все» ничего не отображать до начала поиска "
"(дополнительное скрытие от посторонних глаз)"

#: prefs.js:311
msgid "Hidden-field edge warning"
msgstr "Предупреждение о краевых символах в скрытых полях"

#: prefs.js:312
msgid ""
"Show a ⚠️ icon when a hidden password or field starts or ends with a space, "
"line break or non-printable character. Catches invisible paste typos (Ctrl+V "
"artifact, stray space), but the icon also reveals metadata about the secret "
"value to anyone viewing the screen, e.g. during screen sharing. Off by "
"default."
msgstr "Показывать значок ⚠️, если скрытый пароль или поле начинается или заканчивается пробелом, переносом строки или непечатаемым символом. Помогает заметить невидимые артефакты вставки (лишний пробел, Ctrl+V), но значок также раскрывает сведения о секретном значении тем, кто видит экран, например при демонстрации. По умолчанию выключено."

#: prefs.js:316
msgid "When to ask for the master password"
msgstr "Когда запрашивать мастер-пароль"

#: prefs.js:317
msgid "How often the password vault requests the master password"
msgstr "Как часто хранилище паролей запрашивает мастер-пароль"

#: prefs.js:322
msgid "Reset vault search on close"
msgstr "Сбрасывать поиск хранилища при закрытии"

#: prefs.js:323
msgid ""
"Clear the search filter in the password vault when the vault menu closes"
msgstr "Очищать поисковый фильтр хранилища паролей при закрытии его меню"

#: prefs.js:334
msgid "Item Actions"
msgstr "Действия с элементами"

#: prefs.js:335
msgid "Password Vault Settings"
msgstr "Настройки хранилища паролей"

#: prefs.js:338
msgid "Required: 7-Zip (7z or 7za)"
msgstr "Требуется: 7-Zip (7z или 7za)"

#: prefs.js:339
msgid ""
"The vault is an encrypted ZIP archive. To open and save it the extension "
"needs 7-Zip: install p7zip-full (7z) or p7zip (7za). Keep the archive file "
"in a protected location."
msgstr ""
"Хранилище — это зашифрованный ZIP-архив. Чтобы открывать и сохранять его, "
"расширение использует архиватор 7-Zip(7z или 7za). Храните файл архива в "
"защищённом месте."

