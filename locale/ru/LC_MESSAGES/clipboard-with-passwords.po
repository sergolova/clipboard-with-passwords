msgstr "Размер истории"

#: prefs.js:65
msgid "Maximum number of entries to keep in clipboard history"
msgstr "Максимальное количество записей в истории буфера обмена"

#: prefs.js:74
msgid "Preview Size (characters)"
msgstr "Размер предпросмотра (символов)"

#: prefs.js:75
msgid "Number of characters shown per entry in the history menu"
msgstr "Число символов, показываемых для записи в меню истории"

#: prefs.js:84
msgid "Max cache file size (MB)"
msgstr "Максимальный размер кэша (мб)"

#: prefs.js:85
msgid "Maximum disk space used for caching clipboard data"
msgstr "Максимальный объём диска для кэша данных буфера обмена"

#: prefs.js:94
msgid "Number of characters in top bar"
msgstr "Количество символов в верхней панели"

#: prefs.js:95
msgid "Length of the clipboard content preview shown in the panel"
msgstr "Длина предпросмотра содержимого буфера на панели"

#: prefs.js:104
msgid "What to show in top bar"
msgstr "Что показывать в верхней панели"

#: prefs.js:109
msgid "Remove down arrow in top bar"
msgstr "Убрать стрелку вниз в верхней панели"

#: prefs.js:110
msgid "Hide the dropdown arrow next to the clipboard indicator"
msgstr "Скрывать стрелку раскрытия рядом с индикатором буфера обмена"

#: prefs.js:114
msgid "Blink icon on copy"
msgstr "Мигать значком при копировании"

#: prefs.js:115
msgid "Briefly flash the indicator icon when something is copied"
msgstr "Кратковременно подсвечивать значок индикатора при копировании"

#: prefs.js:119
msgid "Cache only pinned items"
msgstr "Кэшировать только избранное"

#: prefs.js:120
msgid "Only save pinned (favorite) entries to disk"
msgstr "Сохранять на диск только закреплённые (избранные) записи"

#: prefs.js:124
msgid "Show notification on copy"
msgstr "Показывать уведомление при копировании"

#: prefs.js:125
msgid "Display a notification each time text is copied"
msgstr "Показывать уведомление при каждом копировании текста"

#: prefs.js:129
msgid "Show notification on cycle"
msgstr "Показывать уведомление при циклическом переключении"

#: prefs.js:130
msgid "Display a notification when cycling through entries with shortcuts"
msgstr "Показывать уведомление при переключении записей горячими клавишами"

#: prefs.js:134
msgid "Show notification on Clear History"
msgstr "Показывать уведомление при очистке истории"

#: prefs.js:135
msgid "Display a notification when clipboard history is cleared"
msgstr "Показывать уведомление при очистке истории буфера"

#: prefs.js:139
msgid "Prompt for confirmation on Clear History"
msgstr "Запрашивать подтверждение при очистке истории"

#: prefs.js:140
msgid "Ask before deleting all clipboard entries"
msgstr "Спрашивать перед удалением всех записей буфера"

#: prefs.js:144
msgid "Prompt before deleting pinned item"
msgstr "Спрашивать подтверждение перед удалением закреплённого элемента"

#: prefs.js:145
msgid "Ask for confirmation before deleting a pinned item"
msgstr "Запрашивать подтверждение перед удалением закреплённого элемента"

#: prefs.js:149
msgid "Remove spaces around text"
msgstr "Удалить пробелы в тексте"

#: prefs.js:150
msgid "Strip leading and trailing spaces from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие пробелы из текстовых записей при копировании"

#: prefs.js:154
msgid "Remove line breaks around text"
msgstr "Удалять переводы строк вокруг текста"

#: prefs.js:155
msgid "Strip leading and trailing line breaks from text entries on copy"
msgstr ""
"Убирать ведущие и завершающие переводы строк из текстовых записей при "
"копировании"

#: prefs.js:159
msgid "Move item to the top after selection"
msgstr "Переместить запись в начало после выделения"

#: prefs.js:160
msgid "When selecting an entry, bring it to the top of the history"
msgstr "При выборе записи поднимать её в начало истории"

#: prefs.js:164
msgid "Keep selected entry after Clear History"
msgstr "Не очищать выбранную запись после очистки истории"

#: prefs.js:165
msgid ""
"The currently active clipboard entry will not be removed when clearing "
"history"
msgstr ""
"Текущая активная запись буфера обмена не будет удалена при очистке истории"

#: prefs.js:169
msgid "Place the pinned section on the bottom"
msgstr "Размещать закреплённый раздел внизу"

#: prefs.js:170
msgid "Move the pinned section to the bottom of the menu. Requires re-login"
msgstr "Переместить закреплённый раздел вниз меню. Требуется повторный вход"

#: prefs.js:174
msgid "Show Search Bar"
msgstr "Показывать строку поиска"

#: prefs.js:175
msgid "Display a search field at the top of the clipboard menu"
msgstr "Показывать поле поиска в верхней части меню буфера"

#: prefs.js:178
msgid "Show Private Mode"
msgstr "Показывать приватный режим"

#: prefs.js:179
msgid "Display the private mode toggle in the clipboard menu"
msgstr "Показывать переключатель приватного режима в меню буфера"

#: prefs.js:182
msgid "Show Settings Button"
msgstr "Показывать кнопку настроек"

#: prefs.js:183
msgid "Display a shortcut to these settings in the clipboard menu"
msgstr "Показывать быстрый доступ к настройкам в меню буфера"

#: prefs.js:186
msgid "Show Clear History Button"
msgstr "Показывать кнопку очистки истории"

