msgid "The vault archive does not contain valid JSON data."
msgstr "Архив хранилища не содержит корректных данных JSON."

#: passwordVault.js:799 passwordVault.js:802 passwordVault.js:827 passwordVault.js:848
msgid "The vault archive contains invalid data."
msgstr "Архив хранилища содержит недопустимые данные."

#: passwordVault.js:805
msgid "The vault contains too many items (max 1000)."
msgstr "Хранилище содержит слишком много записей (максимум 1000)."

