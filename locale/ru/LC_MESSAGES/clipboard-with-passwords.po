#: extension.js:2412
msgid "Create the master password for the new vault:"
msgstr "Создайте мастер-пароль для нового хранилища:"

#: extension.js:2413 passwordVaultDialog.js:75
msgid "Enter the master password to unlock:"
msgstr "Введите мастер-пароль для разблокировки:"

#: extension.js:2424
msgid "Use a long, unique passphrase — the vault password cannot be recovered."
msgstr "Используйте длинную уникальную фразу-пароль — восстановить пароль хранилища невозможно."

#: extension.js:2481 passwordVault.js:733 passwordVault.js:757
#: passwordVault.js:779 passwordVault.js:801 passwordVault.js:804
msgid "Failed to update the password vault archive."
msgstr "Не удалось обновить архив хранилища паролей."

#: extension.js:2503 passwordVault.js:774
msgid ""
"Another file already exists at the target archive path: %1$s. Move or delete "
"it, then try again."
msgstr ""
"По целевому пути архива уже существует другой файл: %1$s. Переместите или "
"удалите его и повторите попытку."

#: extension.js:2508
msgid "Convert vault format now?"
msgstr "Преобразовать формат хранилища сейчас?"

#: extension.js:2509
msgid ""
"The vault is currently stored as %1$s, but %2$s is selected in Settings."
msgstr ""
"Сейчас хранилище хранится как %1$s, но в настройках выбран формат %2$s."

#: extension.js:2510
msgid ""
"%1$d records will be migrated into the new archive. The previous file is "
"kept and can be deleted afterwards."
msgstr ""
"%1$d записей будут перенесены в новый архив. Прежний файл сохранится — его "
"можно будет удалить после преобразования."

#: extension.js:2511
msgid "Convert now"
msgstr "Преобразовать сейчас"

#: extension.js:2512
msgid "Not now"
msgstr "Не сейчас"

#: extension.js:2520
msgid "Vault converted"
msgstr "Хранилище преобразовано"

#: extension.js:2521
msgid "%1$d records were migrated into: %2$s"
msgstr "%1$d записей перенесено в: %2$s"

#: extension.js:2522
msgid ""
"The previous archive is still at %1$s. Delete it now? The new archive was "
"verified after writing."
msgstr ""
"Прежний архив всё ещё находится по пути %1$s. Удалить его сейчас? Новый "
"архив был проверен после записи."

#: extension.js:2523
msgid "Delete old archive"
msgstr "Удалить старый архив"

#: extension.js:2524
msgid "Keep both"
msgstr "Оставить оба"

#: extension.js:2546
msgid "The password vault has been locked."
msgstr "Хранилище паролей было заблокировано."

#: extension.js:2847
msgid "Clipboard cleared"
msgstr "Буфер обмена очищен"

#: passwordVaultDialog.js:81
msgid "Master password"
msgstr "Мастер-пароль"

#: passwordVaultDialog.js:130
msgid "Unlock"
msgstr "Разблокировать"

#: passwordVaultDialog.js:156
msgid ""
"A longer passphrase is much harder to guess — the vault password cannot be "
"recovered."
msgstr "Чем длиннее фраза-пароль, тем труднее её подобрать — восстановить пароль хранилища невозможно."

#: passwordVaultDialog.js:158
msgid ""
"Good length. Keep this passphrase unique — do not reuse another account's "
"password."
msgstr "Хорошая длина. Сделайте фразу уникальной — не используйте пароль от другой учётной записи."

#: passwordVaultDialog.js:168
msgid "Password cannot be empty"
msgstr "Пароль не может быть пустым"

#: passwordVaultDialog.js:171
msgid "Unlocking…"
msgstr "Разблокировка…"

#: passwordVaultDialog.js:177 passwordVaultDialog.js:182
msgid "Wrong password or archive error"
msgstr "Неверный пароль или ошибка архива"

#: passwordVaultDialog.js:225
msgid "New service"
msgstr "Новый сервис"

#: passwordVaultDialog.js:230
