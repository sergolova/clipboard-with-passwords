#: prefs.js:170
msgid "Delete all cached clipboard entries when the system starts"
msgstr "Удалять все кэшированные записи буфера при запуске системы"

#: prefs.js:174
msgid "Paste on select"
msgstr "Вставка при выделении"

#: prefs.js:175
msgid "Automatically paste the entry into the active window when selected"
msgstr "Автоматически вставлять запись в активное окно при выборе"

#: prefs.js:179
msgid "Open menu at cursor"
msgstr "Открывать меню у курсора"

#: prefs.js:180
msgid "When using the keyboard shortcut, open the menu at the cursor position"
msgstr "При использовании горячей клавиши открывать меню у позиции курсора"

#: prefs.js:185
msgid "Show the delete button on each item"
msgstr "Показывать кнопку удаления на каждом элементе"

#: prefs.js:189
msgid "Tag"
msgstr "Метка"

#: prefs.js:190
msgid "Show the tag button on each item"
msgstr "Показывать кнопку метки на каждом элементе"

#: prefs.js:195
msgid "Show the paste button on each item"
msgstr "Показывать кнопку вставки на каждом элементе"

#: prefs.js:199
msgid "Pin"
msgstr "Закрепить"

#: prefs.js:200
msgid "Show the pin/favorite button on each item"
msgstr "Показывать кнопку закрепления/избранного на каждом элементе"

#: prefs.js:205
msgid "Show the edit button on each text item"
msgstr "Показывать кнопку редактирования на каждом текстовом элементе"

#: prefs.js:209
msgid "Preview"
msgstr "Предпросмотр"

