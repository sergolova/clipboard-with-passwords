<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.clipboard-indicator" path="/org/gnome/shell/extensions/clipboard-indicator/">
    <key name="history-size" type="i">
      <default>15</default>
      <summary>History size</summary>
    </key>
    <key name="preview-size" type="i">
      <default>50</default>
      <summary>Preview size</summary>
    </key>
    <key name="cache-size" type="i">
      <default>5</default>
      <summary>Cache file size</summary>
    </key>
    <key name="cache-only-favorites" type="b">
      <default>false</default>
      <summary>Cache only favorites</summary>
    </key>
    <key name="enable-deletion" type="b">
      <default>true</default>
      <summary>Enable deletion</summary>
    </key>
    <key name="notify-on-copy" type="b">
      <default>true</default>
      <summary>Notify on copy</summary>
    </key>
    <key name="notify-on-cycle" type="b">
      <default>true</default>
      <summary>Notify on cycle</summary>
    </key>
    <key name="notify-on-clear" type="b">
      <default>true</default>
      <summary>Notify on clear</summary>
    </key>
    <key name="confirm-clear" type="b">
      <default>true</default>
      <summary>Confirm on clear</summary>
    </key>
    <key name="confirm-pinned-delete" type="b">
      <default>false</default>
      <summary>Confirm on pinned delete</summary>
    </key>
    <key name="move-item-first" type="b">
      <default>false</default>
      <summary>Move item first</summary>
    </key>
    <key name="enable-keybindings" type="b">
      <default>true</default>
      <summary>Enable keybindings</summary>
    </key>
    <key name="topbar-preview-size" type="i">
      <default>15</default>
      <summary>Topbar preview size</summary>
    </key>
    <key name="display-mode" type="i">
      <default>1</default>
      <summary>Display mode</summary>
    </key>
    <key name="disable-down-arrow" type="b">
      <default>false</default>
      <summary>Disable down arrow</summary>
    </key>
    <key name="blink-icon-on-copy" type="b">
      <default>false</default>
      <summary>Blink icon on copy</summary>
    </key>
    <key name="strip-text" type="b">
      <default>false</default>
      <summary>Strip text</summary>
    </key>
    <key name="keep-selected-on-clear" type="b">
      <default>false</default>
      <summary>Keep selected on clear</summary>
    </key>
    <key name="paste-button" type="b">
      <default>true</default>
      <summary>Paste button</summary>
    </key>
    <key name="pinned-on-bottom" type="b">
      <default>false</default>
      <summary>Pinned on bottom</summary>
    </key>
    <key name="clear-on-boot" type="b">
      <default>false</default>
      <summary>Clear on boot</summary>
    </key>
    <key name="paste-on-select" type="b">
      <default>false</default>
      <summary>Paste on select</summary>
    </key>
    <key name="cache-images" type="b">
      <default>true</default>
      <summary>Cache images</summary>
    </key>
    <key name="excluded-apps" type="as">
      <default>[]</default>
      <summary>Excluded apps</summary>
    </key>
    <key name="clear-history-on-interval" type="b">
      <default>false</default>
      <summary>Clear history on interval</summary>
    </key>
    <key name="clear-history-interval" type="i">
      <default>60</default>
      <summary>Clear history interval</summary>
    </key>
    <key name="next-history-clear" type="x">
      <default>-1</default>
      <summary>Next history clear timestamp</summary>
    </key>
    <key name="case-sensitive-search" type="b">
      <default>false</default>
      <summary>Case sensitive search</summary>
    </key>
    <key name="regex-search" type="b">
      <default>false</default>
      <summary>Regex search</summary>
    </key>
    <key name="show-search-bar" type="b">
      <default>true</default>
      <summary>Show search bar</summary>
    </key>
    <key name="show-private-mode" type="b">
      <default>true</default>
      <summary>Show private mode</summary>
    </key>
    <key name="show-settings-button" type="b">
      <default>true</default>
      <summary>Show settings button</summary>
    </key>
    <key name="show-clear-history-button" type="b">
      <default>true</default>
      <summary>Show clear history button</summary>
    </key>
    <key name="open-at-cursor" type="b">
      <default>false</default>
      <summary>Open at cursor</summary>
    </key>
    <key name="show-delete-button" type="b">
      <default>true</default>
      <summary>Show delete button</summary>
    </key>
    <key name="show-tag-button" type="b">
      <default>true</default>
      <summary>Show tag button</summary>
    </key>
    <key name="show-pin-button" type="b">
      <default>true</default>
      <summary>Show pin button</summary>
    </key>
    <key name="show-edit-button" type="b">
      <default>true</default>
      <summary>Show edit button</summary>
    </key>
    <key name="show-preview-button" type="b">
      <default>true</default>
      <summary>Show preview button</summary>
    </key>

    <key name="password-vault-path" type="s">
      <default>'~/.config/clipboard-indicator/passwords.zip'</default>
      <summary>Path to encrypted password vault ZIP archive</summary>
    </key>
    <key name="vault-enabled" type="b">
      <default>true</default>
      <summary>Enable the built-in password vault (right-click or hotkey opens it)</summary>
    </key>
    <key name="vault-copy-to-history" type="b">
      <default>false</default>
      <summary>Add everything copied from the vault to the visible clipboard history. WARNING: this stores passwords and logins in the plain-text clipboard list, which is insecure. Keep it off unless you understand the risk.</summary>
    </key>
    <key name="toggle-password-vault" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;p']</default>
      <summary>Toggle password vault hotkey</summary>
    </key>
    <key name="vault-pin-recent" type="b">
      <default>true</default>
      <summary>Pin the last used service card at the top of the password vault</summary>
    </key>
    <key name="vault-hide-all-category" type="b">
      <default>false</default>
      <summary>Hide services when the "All" category is selected until the user types in the search box</summary>
    </key>
    <key name="colorize-clipboard" type="b">
      <default>true</default>
      <summary>Colorize clipboard entries by content type</summary>
    </key>
    <key name="fetch-youtube-titles" type="b">
      <default>true</default>
      <summary>Fetch and show YouTube video titles for copied links</summary>
    </key>

    <key name="toggle-menu" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;v']</default>
      <summary>Toggle menu hotkey</summary>
    </key>
    <key name="clear-history" type="as">
      <default>[]</default>
      <summary>Clear history hotkey</summary>
    </key>
    <key name="prev-entry" type="as">
      <default>[]</default>
      <summary>Previous entry hotkey</summary>
    </key>
    <key name="next-entry" type="as">
      <default>[]</default>
      <summary>Next entry hotkey</summary>
    </key>
    <key name="private-mode-binding" type="as">
      <default>[]</default>
      <summary>Private mode hotkey</summary>
    </key>
  </schema>
</schemalist>
